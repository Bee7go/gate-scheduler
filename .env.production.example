APP_NAME="Airport Gate Scheduler"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://scheduler.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gate_scheduler
DB_USERNAME=gate_scheduler
DB_PASSWORD=

POSTGRES_DB=gate_scheduler
POSTGRES_USER=gate_scheduler
POSTGRES_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=180

SESSION_DRIVER=redis
SESSION_STORE=redis
SESSION_SECURE_COOKIE=true

AIRPORT_ICAO=EHAM
OPENSKY_LOOKBACK_SECONDS=7200
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_VERIFY_SSL=true
OPENSKY_FETCH_MAX_ATTEMPTS=3
OPENSKY_FETCH_RETRY_BASE_DELAY_MS=500
OPENSKY_FETCH_TIMEOUT_SECONDS=10
OPENSKY_FALLBACK_CACHE_TTL_SECONDS=900
OPENSKY_BREAKER_FAILURE_THRESHOLD=3
OPENSKY_BREAKER_FAILURE_WINDOW_SECONDS=300
OPENSKY_BREAKER_COOLDOWN_SECONDS=600

GATE_OCCUPATION_TIME=90
GATE_ALLOCATION_STRATEGY=greedy

APP_DOMAIN=scheduler.example.com
